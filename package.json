{
  "name": "jungle-leaderboard",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Leaderboard for a coding benchmark in which SOTA AI models build a playable Jungle (Dou Shou Qi) program.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:arena": "vite --config arena/vite.config.ts",
    "dev:full": "node --import tsx scripts/api-server.ts --port 8788",
    "build": "node scripts/verify-rules-digest.mjs && astro check && vue-tsc --noEmit -p arena/tsconfig.json && tsc -p functions/tsconfig.json && astro build && vite build --config arena/vite.config.ts",
    "preview": "node scripts/serve-static.mjs dist --port 4400",
    "check": "astro check && vue-tsc --noEmit -p arena/tsconfig.json && tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:fixtures": "node scripts/build-test-fixtures.mjs",
    "catalog:add": "node --import tsx scripts/catalog-add.ts",
    "catalog:verify": "vitest run arena/src/catalog/seed-catalog.test.ts",
    "conformance": "node --import tsx scripts/conformance.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:seed": "node --import tsx scripts/db-seed.ts",
    "cf-typegen": "wrangler types",
    "deploy": "node scripts/check-deploy-config.mjs && npm test && npm run build && wrangler d1 migrations apply jungle-arena --remote && wrangler pages deploy dist --project-name jungle-leaderboard --branch main --commit-dirty=true",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@bytecodealliance/jco-transpile": "0.24.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "idb": "8.0.4",
    "tailwindcss": "^4.3.3",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "6.2.8",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.14",
    "wrangler": "^4.123.0"
  }
}
