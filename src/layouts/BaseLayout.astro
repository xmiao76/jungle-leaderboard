---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Pre-serialized JSON-LD, injected verbatim into a ld+json script tag. */
  structuredData?: string;
}

const { title, description, structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jungle Leaderboard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="generator" content={Astro.generator} />
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#leaderboard"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-ink"
    >
      Skip to leaderboard
    </a>
    <slot />
  </body>
</html>
