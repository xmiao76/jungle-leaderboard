---
import type { RankedEntry } from '../lib/ranking';
import ArtifactLinks from './ArtifactLinks.astro';

interface Props {
  entries: readonly RankedEntry[];
}

const { entries } = Astro.props;

// Only the medal places appear here; the full field is in the table below.
const podium = entries.filter((entry) => entry.place <= 3);

const PLACE_STYLES = {
  1: { medal: '🥇', label: 'First place', card: 'border-gold-line bg-gold-soft', ink: 'text-gold', rise: 'md:pb-10' },
  2: { medal: '🥈', label: 'Second place', card: 'border-silver-line bg-silver-soft', ink: 'text-silver', rise: 'md:pb-6' },
  3: { medal: '🥉', label: 'Third place', card: 'border-bronze-line bg-bronze-soft', ink: 'text-bronze', rise: 'md:pb-4' },
} as const;

const styleFor = (place: number) => PLACE_STYLES[place as 1 | 2 | 3] ?? PLACE_STYLES[3];

// The <ol> below emits 1 · 2 · 3 so screen readers and Tab order follow the
// ranking; `.podium` in global.css reorders it to 2 · 1 · 3 visually at 48rem
// and up. Never "fix" the DOM order to match what appears on screen.
---

<section aria-labelledby="podium-heading" class="mt-10">
  <h2 id="podium-heading" class="sr-only">Top three</h2>

  <ol class="podium grid gap-4 md:grid-cols-3">
    {
      podium.map((entry, index) => {
        const style = styleFor(entry.place);
        return (
          <li
            class:list={[
              'reveal-rise flex flex-col rounded-2xl border p-5 md:p-6',
              style.card,
              style.rise,
            ]}
            style={`--i:${index}`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-3xl leading-none" aria-hidden="true">
                {style.medal}
              </span>
              <span
                class:list={[
                  'text-[0.66rem] font-semibold tracking-[0.12em] uppercase',
                  style.ink,
                ]}
              >
                {style.label}
                {entry.isTied && ' (tied)'}
              </span>
            </div>

            <h3 class="mt-4 font-display text-xl leading-tight font-semibold text-balance text-fg">
              {entry.model}
            </h3>

            <p class="mt-1.5 text-sm text-subtle">
              {entry.provider} · {entry.access === 'open' ? 'open weights' : 'closed weights'}
            </p>

            <p class="mt-3 font-mono text-xs text-muted">{entry.harness}</p>

            <div class="mt-5">
              <ArtifactLinks
                model={entry.model}
                playUrl={entry.playUrl}
                sourceUrl={entry.sourceUrl}
                prominent
              />
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
