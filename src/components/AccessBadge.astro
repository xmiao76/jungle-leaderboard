---
import type { Access } from '../data/models';

interface Props {
  access: Access;
}

const { access } = Astro.props;

// Filled dot for open weights, hollow for closed. The label carries the meaning,
// so the dot is reinforcement rather than the only signal. Deliberately not a
// second accent hue: the palette holds one accent plus the three medals.
const DOT = {
  open: 'border-accent bg-accent',
  closed: 'border-line-strong',
} as const;

const LABELS = {
  open: 'Open',
  closed: 'Closed',
} as const;

const TITLES = {
  open: 'Open weights — publicly downloadable',
  closed: 'Closed weights — available via API only',
} as const;
---

<span class="inline-flex items-center gap-2 text-xs font-medium text-muted" title={TITLES[access]}>
  <span class:list={['h-2 w-2 shrink-0 rounded-full border', DOT[access]]} aria-hidden="true"></span>
  {LABELS[access]}
</span>
