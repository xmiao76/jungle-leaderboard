---
interface Props {
  model: string;
  playUrl: string;
  sourceUrl: string;
  /** Larger treatment for the podium, where these are the primary call to action. */
  prominent?: boolean;
}

const { model, playUrl, sourceUrl, prominent = false } = Astro.props;

const BUTTON =
  'inline-flex items-center gap-1.5 rounded-full font-semibold whitespace-nowrap transition-colors';
const SIZE = prominent ? 'px-4 py-2 text-sm' : 'px-3 py-1.5 text-xs';
const ICON = prominent ? 'h-4 w-4' : 'h-3.5 w-3.5';
---

<div class:list={['flex flex-wrap items-center', prominent ? 'gap-2.5' : 'gap-2']}>
  <a
    href={playUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Play the Jungle build by ${model} (opens in a new tab)`}
    class:list={[BUTTON, SIZE, 'bg-accent text-accent-ink hover:brightness-110']}
  >
    <svg viewBox="0 0 24 24" class={ICON} aria-hidden="true">
      <path d="M8 5.5 19 12 8 18.5V5.5Z" fill="currentColor"></path>
    </svg>
    Play
  </a>

  <a
    href={sourceUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View the source code for ${model} on GitHub (opens in a new tab)`}
    class:list={[
      BUTTON,
      SIZE,
      'border border-line-strong text-muted hover:border-accent hover:text-accent',
    ]}
  >
    <svg
      viewBox="0 0 24 24"
      class={ICON}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 6-5 6 5 6M15 6l5 6-5 6"></path>
    </svg>
    Source
  </a>
</div>
