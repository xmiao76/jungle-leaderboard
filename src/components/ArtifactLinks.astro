---
interface Props {
  model: string;
  playUrl: string;
  sourceUrl: string;
}

const { model, playUrl, sourceUrl } = Astro.props;

const BUTTON_BASE =
  'inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold whitespace-nowrap transition-colors';
---

<div class="flex flex-wrap gap-2">
  <a
    href={playUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Play the Jungle build by ${model} (opens in a new tab)`}
    class:list={[BUTTON_BASE, 'bg-accent text-accent-ink hover:brightness-110']}
  >
    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" aria-hidden="true">
      <path d="M8 5.5 19 12 8 18.5V5.5Z" fill="currentColor"></path>
    </svg>
    Play
  </a>

  <a
    href={sourceUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View the source code for ${model} on GitHub (opens in a new tab)`}
    class:list={[
      BUTTON_BASE,
      'border border-line-strong bg-inset text-muted hover:border-accent hover:text-accent',
    ]}
  >
    <svg
      viewBox="0 0 24 24"
      class="h-3.5 w-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m9 6-5 6 5 6M15 6l5 6-5 6"></path>
    </svg>
    Source
  </a>
</div>
