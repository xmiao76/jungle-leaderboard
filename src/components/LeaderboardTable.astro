---
import type { RankedEntry } from '../lib/ranking';
import ModelRow from './ModelRow.astro';

interface Props {
  entries: readonly RankedEntry[];
  showRecord: boolean;
}

const { entries, showRecord } = Astro.props;

const HEADINGS = ['Rank', 'Model', 'Access', 'Coding harness', 'Effort'] as const;
const HEAD_CELL = 'px-4 py-3.5 font-semibold';
---

<section id="leaderboard" aria-labelledby="leaderboard-heading" class="mt-12 scroll-mt-8 sm:mt-16">
  <div class="flex items-baseline gap-4">
    <h2 id="leaderboard-heading" class="font-display text-2xl font-semibold text-fg">
      Full standings
    </h2>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <div
    class="mt-5 md:overflow-x-auto md:rounded-2xl md:border md:border-line md:bg-raised md:shadow-[0_1px_2px_rgba(0,0,0,0.04)]"
  >
    <table class="lb-table w-full caption-bottom border-collapse text-left text-sm">
      <caption class="px-1 pt-4 text-xs leading-relaxed text-subtle md:px-5 md:pb-4">
        Standard competition ranking: two models share fifth place, so no sixth place is awarded.
        <span class="whitespace-nowrap">Access</span> indicates whether the model's weights are publicly
        available. Every link opens in a new tab.
      </caption>

      <thead>
        <tr
          class="border-b border-line-strong bg-inset text-[0.68rem] tracking-[0.1em] text-subtle uppercase"
        >
          {HEADINGS.map((heading) => (
            <th scope="col" class={HEAD_CELL}>{heading}</th>
          ))}
          {showRecord && (
            <th scope="col" class={HEAD_CELL}>Record</th>
          )}
          <th scope="col" class={HEAD_CELL}>Artifacts</th>
        </tr>
      </thead>

      <tbody>
        {entries.map((entry, index) => (
          <ModelRow entry={entry} showRecord={showRecord} index={index} />
        ))}
      </tbody>
    </table>
  </div>
</section>
