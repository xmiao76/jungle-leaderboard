---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="mt-14 scroll-mt-8 border-t border-line pt-10">
  <h2 id={headingId} class="text-xl font-semibold tracking-tight text-fg">{title}</h2>
  <div class="mt-5 max-w-3xl space-y-4 text-sm leading-relaxed text-muted">
    <slot />
  </div>
</section>
