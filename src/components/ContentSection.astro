---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} aria-labelledby={headingId} class="mt-14 scroll-mt-8 sm:mt-16">
  <div class="flex items-baseline gap-4">
    <h2 id={headingId} class="font-display text-2xl font-semibold text-fg">{title}</h2>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <div class="mt-5 max-w-3xl space-y-4 text-sm leading-relaxed text-muted">
    <slot />
  </div>
</section>
