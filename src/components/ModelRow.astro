---
import type { RankedEntry } from '../lib/ranking';
import { formatRecord } from '../lib/format';
import AccessBadge from './AccessBadge.astro';
import ArtifactLinks from './ArtifactLinks.astro';
import RankBadge from './RankBadge.astro';

interface Props {
  entry: RankedEntry;
  showRecord: boolean;
  /** Position in the rendered list, used to stagger the reveal. */
  index: number;
}

const { entry, showRecord, index } = Astro.props;

// Passed as a CSS variable rather than a utility class so one value drives both
// the desktop rule (first cell's left border) and the mobile card's left edge.
const RULE_COLOR = {
  gold: 'var(--c-gold)',
  silver: 'var(--c-silver)',
  bronze: 'var(--c-bronze)',
} as const;

const rule = entry.medal ? RULE_COLOR[entry.medal] : 'var(--c-accent-line)';

// Offset by the three podium cards so the whole page reveals top to bottom.
const REVEAL_OFFSET = 3;

const CELL = 'md:border-b md:border-line md:px-4 md:py-4 md:align-middle';
---

<tr class="reveal-fade" style={`--i:${index + REVEAL_OFFSET};--rule:${rule}`}>
  <td data-label="Rank" class:list={[CELL, 'md:pl-5']}>
    <RankBadge place={entry.place} medal={entry.medal} isTied={entry.isTied} />
  </td>

  <td data-label="Model" class={CELL}>
    <div class="font-display text-base leading-snug font-semibold text-fg">{entry.model}</div>
    <div class="mt-0.5 text-xs text-subtle">{entry.provider}</div>
  </td>

  <td data-label="Access" class={CELL}>
    <AccessBadge access={entry.access} />
  </td>

  <td data-label="Coding harness" class={CELL}>
    <span class="font-mono text-[0.8rem] text-muted">{entry.harness}</span>
  </td>

  <td data-label="Effort" class={CELL}>
    <span class="text-sm text-muted">{entry.effort}</span>
  </td>

  {
    showRecord && (
      <td data-label="Record" class={CELL}>
        <span class="font-mono text-sm text-muted">{formatRecord(entry.record)}</span>
      </td>
    )
  }

  <td data-label="Artifacts" data-span class={CELL}>
    <ArtifactLinks model={entry.model} playUrl={entry.playUrl} sourceUrl={entry.sourceUrl} />
  </td>
</tr>
